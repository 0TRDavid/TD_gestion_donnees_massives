table Criteres_Satisfaction
	lineageTag: a3f7cda4-711a-4305-a4d9-f0d033e7d9f6

	measure 'Note moyenne par critère' =
			
			SWITCH(
			    SELECTEDVALUE(Criteres_Satisfaction[Critere]),
			    "Culture et valeurs", [Note moyenne culture valeurs],
			    "Équipe dirigeante",[Note moyenne équipe dirigeante],
			    "Opportunités de carrière",[Note moyenne opportunités carrière],
			    "Rémunération et avantages", [Note moyenne rémunération],
			    "Équilibre vie professionnelle", [Note moyenne équilibre vie pro]
			)
		lineageTag: 490e6b62-2ee0-458b-bff2-f913433bb3f3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Critere
		lineageTag: 17503a44-f0dc-4786-b558-418132be3326
		summarizeBy: none
		isNameInferred
		sourceColumn: [Critere]

		annotation SummarizationSetBy = Automatic

	partition Criteres_Satisfaction = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Critere", STRING,
				    {
				        {"Culture et valeurs"},
				        {"Équipe dirigeante"},
				        {"Opportunités de carrière"},
				        {"Rémunération et avantages"},
				        {"Équilibre vie professionnelle"}
				    }
				)

	annotation PBI_Id = ac761ebabf9349989d16aedd2764671b

